# Copy to .env for local Docker Compose use. Never commit real values.
# SQL Server 2022 requires a strong password (8+ chars, three of: upper, lower, digit, symbol).
CMS_RELEASE_SHA=local
CMS_DB_PASSWORD=change-me-Str0ng!
CMS_DATABASE_CONNECTION=Server=localhost,1433;Database=Cms;User Id=sa;Password=change-me-Str0ng!;TrustServerCertificate=True;Encrypt=True
# First administrator, created once by POST /api/identity/bootstrap while the system has no users. Leave false; set true only for
# the first start of a new installation, then set it back to false. (Development turns it on by itself.)
CMS_BOOTSTRAP_ENABLED=false
