# Copy to .env for local Docker Compose use. Never commit real values.
# Every REPLACE-ME value below is deliberately not a usable password: SQL Server and the setup script refuse it, so a copy that was
# never edited fails loudly instead of running with a published password. Use a password manager to generate each one.
#
# SQL Server administrator ("sa"). Used for the database container, migrations and backups; never given to the API.
# SQL Server needs 8+ characters with three of: upper case, lower case, digit, symbol.
CONSTRUCTOPX_DB_PASSWORD=REPLACE-ME
# The API's own database login "constructopx_app" (read and write only). 12+ characters, no single quote and no "$(".
CONSTRUCTOPX_APP_DB_PASSWORD=REPLACE-ME
CONSTRUCTOPX_RELEASE_SHA=local
# For running the API on your machine with `dotnet run` against the compose database (development only; use the administrator login
# here so the development database can be created and migrated):
# CONSTRUCTOPX_DATABASE_CONNECTION=Server=localhost,1433;Database=ConstructOpx;User Id=sa;Password=<CONSTRUCTOPX_DB_PASSWORD>;TrustServerCertificate=True
# First administrator, created once by POST /api/identity/bootstrap while the system has no users. Leave false; set true only for
# the first start of a new installation, then set it back to false. (Development turns it on by itself.)
CONSTRUCTOPX_BOOTSTRAP_ENABLED=false
