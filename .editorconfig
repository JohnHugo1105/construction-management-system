root = true

[*]
charset = utf-8
# DriveOPX uses CRLF because its owner works on Windows only. This repository is built on Windows and Linux (CI, cloud
# sessions), so LF is the single line ending and .gitattributes enforces it. See docs/development/standards-deviations.md.
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets,json,yml,yaml,md,ts,html,scss}]
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

# EF Core writes migrations with a block namespace and regenerates them whenever the model changes before a first release,
# so style rules do not apply to them.
[src/Cms.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
