{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Cms": ""
  },
  "Bootstrap": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "SignInPerMinute": 10
  },
  "PasswordHashing": {
    "Iterations": 600000
  }
}
